RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://persiaplay.ir%{REQUEST_URI} [L,R=301]

# Serve installer binaries under /downloads/ as attachments
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/downloads/.*\.exe$" serve_exe_attachment
  Header set Content-Type "application/octet-stream" env=serve_exe_attachment
  Header set Content-Disposition "attachment" env=serve_exe_attachment
</IfModule>
<IfModule mod_mime.c>
  <FilesMatch "\.exe$">
    ForceType application/octet-stream
  </FilesMatch>
</IfModule>

